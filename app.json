{
  "expo": {
    "name": "Atlasphere",
    "slug": "atlasphere-mobile",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "atlasphere",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.atlasphere.mobile"
    },
    "android": {
      "package": "app.atlasphere.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B3856",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#E8933A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atlasphere uses your photos so you can add a trip picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://atlasphere.up.railway.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "829aec12-43bc-433d-9e38-5d87bd0aab5d"
      }
    },
    "owner": "nashwah-2"
  }
}
